{
	"name": "product-lens",
	"version": "0.1.0",
	"private": true,
	"main": "index.ts",
	"scripts": {
		"start": "expo start --dev-client",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"check-types": "tsc --noEmit",
		"eas:android": "npx eas-cli build --profile development --platform android",
